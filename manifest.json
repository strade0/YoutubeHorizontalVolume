{
  "manifest_version": 3,
  "name": "YouTube Toolkit",
  "version": "1.0.2",
  "description": "Volume drag, layout trimmer, and auto Jump Ahead — three YouTube tools in one extension, each with its own toggle.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["features/volume/main_bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/volume/styles.css"],
      "js": [
        "features/volume/visualizer.js",
        "features/volume/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["features/trimmer/content.css"],
      "js": ["features/trimmer/content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["features/skipit/content.js"],
      "run_at": "document_start"
    }
  ]
}
