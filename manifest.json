{
  "manifest_version": 3,
  "name": "YouTube Viewport Volume Drag",
  "version": "1.0.0",
  "description": "Adjust YouTube video volume by smoothly dragging your mouse horizontally across the viewport with a sleek modern visualizer.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/main_bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "content/styles.css"
      ],
      "js": [
        "content/visualizer.js",
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
